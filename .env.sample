# Required
DATABASE_URL=postgresql://pladias:pladias@localhost:7777/pladias

# Optional
LOG_LEVEL=INFO

# GBIF open-data S3 bucket
#GBIF_S3_BUCKET=gbif-opendata-eu-central-1
#GBIF_AWS_REGION=eu-central-1

# Occurrence filters (empty taxon key/rank = all taxa)
#GBIF_POLYGON=POLYGON((11.83149 51.29958, 11.66493 48.09954, 19.16497 48.09965, 19.33152 51.29969, 14.64381 51.29962, 11.83149 51.29958))
#GBIF_TAXON_KEY=
#GBIF_TAXON_RANK=SPECIES
#GBIF_OCCURRENCE_STATUS=PRESENT
# comma-separated; empty value disables the exclusion
#GBIF_EXCLUDED_ISSUES=COORDINATE_OUT_OF_RANGE,ZERO_COORDINATE,COORDINATE_INVALID,COORDINATE_REPROJECTION_FAILED
#GBIF_BATCH_SIZE=10000
